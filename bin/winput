#!/usr/bin/env bash
# bin/winput - guarded synthetic input. Dry-run by default; real injection needs --yes + a valid grant.
set -uo pipefail
. "$(dirname "$0")/../lib/common.sh"
. "$(dirname "$0")/../lib/audit.sh"
wa_audit_init winput "$@"

usage() {
  cat <<'EOF'
usage:
  winput move X Y
  winput click X Y [--button left|right|middle] [--count N]
  winput click --click-text RE [--text-index N] --expect-hwnd H
                              click the center of the Nth text line whose name matches RE,
                              resolved through "wuia --find-text"; the JSON gains hit:{name,rect,...}
                              (T21: text -> geometry -> point, never a blind coordinate).
  winput click --reveal (--reveal-aid|--reveal-name|--reveal-class) RE [--reveal-index N]
                        --expect-hwnd H
                              scroll the target into view first (ops/reveal), then click the point
                              it proved; the JSON gains reveal:{steps,moved,point,element,container,
                              scroll}; every step is re-checked, a target that cannot be revealed
                              is an error (rc=3 ENV_NO_MATCH / ENV_NOT_REVEALED / ENV_SCROLL_NOT_MOVED)
                              and nothing is injected. --reveal is click-only, needs --expect-hwnd,
                              and is refused together with X Y or --click-text.
  winput click X Y [--expect-change title|rect[,..]] [--timeout MS]
                              click, then prove the window actually changed (ENV_NO_EFFECT rc=3).
                              Every click reports hit (object, or null + hitReason); every
                              hover/wheel keeps its v1.2 under{window,element} and adds
                              underNode (warm-tree rect hit: name/type/rect/via).
  winput dclick X Y
  winput drag X1 Y1 X2 Y2 [--steps N]
  winput wheel [X Y | --at X,Y] [--delta N] [--times N] [--horizontal]
                              scroll at a point (default delta 120 = one notch, +away/-toward)
  winput hover X Y [--steps N] [--dwell MS]
                              glide to a point, dwell, then report the element under it
  winput key COMBO [--hold MS]  (e.g. ctrl+s, alt+f4, enter, f5) - hold keeps keys down MS ms
  winput keydown KEY          press and KEEP DOWN one key (a, shift, f5, space)
  winput keyup KEY            release one key pressed with keydown
  winput releaseall           release every key left down (safety net; also --dry-run)
  winput type --text "..." | --text-file PATH | --stdin | --text-b64 B64
                              --stdin reads UTF-8 from standard input (quote-proof, preferred);
                              --text-b64 takes base64 so no shell quoting applies at all.
                              --text-file accepts a WSL path (/tmp/x.txt) or a Windows path;
                              empty text is an error (ARG_EMPTY_TEXT), a missing file is
                              ARG_TEXT_FILE_NOT_FOUND - never a silent no-op.
                              --verify exact|contains reads the focused element back and
                              fails rc=3 ENV_TEXT_NOT_ENTERED when the text did not land.
                              Without --force, type refuses rc=3 ENV_NO_FOCUS when the focused
                              element cannot receive text, and rc=3 ENV_NO_EFFECT when the
                              readable value did not change after the paste.
Flags for all actions:
  --yes              actually inject (default is --dry-run)
  --dry-run          only print the plan (default)
  --expect-hwnd H    required for click/dclick/drag (S7: never click blind)
  --focus            try SetForegroundWindow when target is not foreground
  --allow-related    accept a point/foreground that lands on an owner or child dialog of
                     --expect-hwnd (same window family); JSON reports matched:"related"
  --no-restore-clip  for type: do not restore the previous clipboard
  --force            for type: skip the focus check and the "paste never appeared" check
                     (v1.2 behaviour: ok:true even when the text may have gone nowhere)
exit 0 ok | 2 arg | 3 env (locked / wrong window / not foreground) | 4 guard | 5 exec
EOF
}

ACTION=""; X=""; Y=""; X2=""; Y2=""; BUTTON="left"; COUNT=1; STEPS=20
DELTA=120; TIMES=1; HORIZ=0; DWELL=600; AT=""
COMBO=""; HOLD=20; TEXT=""; TF=""; HWND="0"; REAL=0; FOCUS=0; NOCLIP=0; ALLOW_RELATED=0; VERIFY_MODE=""; FORCE=0
TEXT_SET=0; B64=""; USE_STDIN=0; CLICK_TEXT=""; TIDX=0; HIT_JSON=""
EXPECT_CHANGE=""; TMO=2000; UNDER_JSON=""; HIT_REASON=""
REVEAL=0; RVAID=""; RVNAME=""; RVCLASS=""; RVINDEX=0; REVEAL_JSON=""
HELD_FILE="$APP_ROOT/tmp/held.json"

[ $# -gt 0 ] || { WA_AUDIT_RESULT=ARG_NO_ARGS; usage >&2; exit 2; }
case "$1" in -h|--help) WA_AUDIT_RESULT=help; usage; exit 0 ;; esac
ACTION="$1"; shift

pos=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) WA_AUDIT_RESULT=help; usage; exit 0 ;;
    --yes) REAL=1; shift ;;
    --dry-run) REAL=0; shift ;;
    --button) BUTTON="$2"; shift 2 ;;
    --count) COUNT="$2"; shift 2 ;;
    --steps) STEPS="$2"; shift 2 ;;
    --delta) DELTA="$2"; shift 2 ;;
    --times) TIMES="$2"; shift 2 ;;
    --horizontal) HORIZ=1; shift ;;
    --dwell) DWELL="$2"; shift 2 ;;
    --hold) HOLD="$2"; shift 2 ;;
    --at) AT="$2"; shift 2 ;;
    --expect-hwnd) HWND="$2"; shift 2 ;;
    --focus) FOCUS=1; shift ;;
    --allow-related) ALLOW_RELATED=1; shift ;;
    --no-restore-clip) NOCLIP=1; shift ;;
    --force) FORCE=1; shift ;;
    --text) TEXT="$2"; TEXT_SET=1; shift 2 ;;
    --stdin) USE_STDIN=1; shift 2 ;;
    --text-b64) B64="$2"; shift 2 ;;
    --text-file) TF="$2"; shift 2 ;;
    --verify) VERIFY_MODE="$2"; shift 2 ;;
    --click-text) CLICK_TEXT="$2"; shift 2 ;;
    --text-index) TIDX="$2"; shift 2 ;;
    --expect-change) EXPECT_CHANGE="$2"; shift 2 ;;
    --reveal) REVEAL=1; shift ;;
    --reveal-aid) REVEAL=1; RVAID="$2"; shift 2 ;;
    --reveal-name) REVEAL=1; RVNAME="$2"; shift 2 ;;
    --reveal-class) REVEAL=1; RVCLASS="$2"; shift 2 ;;
    --reveal-index) REVEAL=1; RVINDEX="$2"; shift 2 ;;
    --timeout) TMO="$2"; shift 2 ;;
    -*) WA_AUDIT_RESULT=ARG_UNKNOWN_FLAG; echo "unknown flag: $1" >&2; exit 2 ;;
    *) pos+=("$1"); shift ;;
  esac
done

case "$ACTION" in
  move)
    [ ${#pos[@]} -eq 2 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "move needs X Y" >&2; exit 2; }
    X="${pos[0]}"; Y="${pos[1]}" ;;
  click|dclick)
    if [ "${REVEAL}" -eq 1 ]; then
      [ "${ACTION}" = "click" ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "--reveal only applies to click" >&2; exit 2; }
      [ ${#pos[@]} -eq 0 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "--reveal takes no X Y (the point comes from ops/reveal)" >&2; exit 2; }
      [ -z "$CLICK_TEXT" ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "--reveal and --click-text are mutually exclusive" >&2; exit 2; }
      [ "${HWND}" != "0" ] || { WA_AUDIT_RESULT=ARG_NEED_HWND; echo "--reveal needs --expect-hwnd (never click blind)" >&2; exit 2; }
    elif [ -n "$CLICK_TEXT" ]; then
      [ "$ACTION" = "click" ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "--click-text only applies to click" >&2; exit 2; }
      [ ${#pos[@]} -eq 0 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "--click-text takes no X Y" >&2; exit 2; }
      [ "$HWND" != "0" ] || { WA_AUDIT_RESULT=ARG_NEED_HWND; echo "--click-text needs --expect-hwnd (never click blind)" >&2; exit 2; }
    else
      [ ${#pos[@]} -eq 2 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "$ACTION needs X Y" >&2; exit 2; }
      X="${pos[0]}"; Y="${pos[1]}"
    fi ;;
  drag)
    [ ${#pos[@]} -eq 4 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "drag needs X1 Y1 X2 Y2" >&2; exit 2; }
    X="${pos[0]}"; Y="${pos[1]}"; X2="${pos[2]}"; Y2="${pos[3]}" ;;
  wheel)
    if [ -n "$AT" ]; then
      case "$AT" in *,*) X="${AT%%,*}"; Y="${AT#*,}" ;; *)
        WA_AUDIT_RESULT=ARG_BAD_POS; echo "--at needs X,Y" >&2; exit 2 ;; esac
      [ ${#pos[@]} -eq 0 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "wheel takes either X Y or --at X,Y, not both" >&2; exit 2; }
    else
      [ ${#pos[@]} -eq 2 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "wheel needs a point: X Y or --at X,Y" >&2; exit 2; }
      X="${pos[0]}"; Y="${pos[1]}"
    fi
    case "$X$Y" in *[!0-9-]*) WA_AUDIT_RESULT=ARG_BAD_POS; echo "not a number: $X,$Y" >&2; exit 2 ;; esac ;;
  hover)
    [ ${#pos[@]} -eq 2 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "hover needs X Y" >&2; exit 2; }
    X="${pos[0]}"; Y="${pos[1]}" ;;
  key)
    [ ${#pos[@]} -eq 1 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "key needs a combo like ctrl+s" >&2; exit 2; }
    COMBO="${pos[0]}" ;;
  keydown|keyup)
    [ ${#pos[@]} -eq 1 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "$ACTION needs one key name" >&2; exit 2; }
    COMBO="${pos[0]}" ;;
  releaseall)
    [ ${#pos[@]} -eq 0 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "releaseall takes no arguments" >&2; exit 2; } ;;
  type) : ;;
  move|click|dclick|drag|wheel|hover|key|keydown|keyup|releaseall|type) ;;
  *) WA_AUDIT_RESULT=ARG_BAD_ACTION; echo "unknown action: $ACTION" >&2; usage >&2; exit 2 ;;
esac

# T29 (F21): --reveal resolves the element through ops/reveal first, then clicks the point it
# proved. The reveal already ran a hit-test on that point, so no second wuia --point is needed.
if [ "${REVEAL}" -eq 1 ]; then
  RV=()
  [ -n "${RVAID}" ] && RV+=(--find-aid "${RVAID}")
  [ -n "${RVNAME}" ] && RV+=(--find-name "${RVNAME}")
  [ -n "${RVCLASS}" ] && RV+=(--find-class "${RVCLASS}")
  [ ${#RV[@]} -gt 0 ] || {
    WA_AUDIT_RESULT=ARG_NEED_REVEAL; echo "--reveal needs --reveal-aid, --reveal-name or --reveal-class" >&2; exit 2; }
  RVY=()
  [ "${REAL}" -eq 1 ] && RVY+=(--yes)
  RJ="$(bash "$REPO_DIR/ops/reveal" --hwnd "${HWND}" "${RV[@]}" --index "${RVINDEX}" "${RVY[@]}")"; RRC=$?
  if [ $RRC -ne 0 ]; then
    WA_AUDIT_RESULT="$(printf '%s' "$RJ" | jq -r '.code // "ENV_REVEAL_FAILED"' 2>/dev/null || echo ENV_REVEAL_FAILED)"
    printf '%s
' "$RJ"; exit $RRC
  fi
  if [ "${REAL}" -eq 0 ]; then
    # dry-run: report the reveal plan, do not pretend to have a clickable point
    WA_AUDIT_RESULT=dryrun
    printf '%s' "$RJ" | jq -c '{ok:true,dry_run:true,plan:"reveal",reveal:.}'
    exit 0
  fi
  X="$(printf '%s' "$RJ" | jq -r '.point.x // empty')"
  Y="$(printf '%s' "$RJ" | jq -r '.point.y // empty')"
  if [ -z "$X" ] || [ -z "$Y" ]; then
    WA_AUDIT_RESULT=EXEC_NO_JSON
    printf '%s' "$RJ" | jq -c '{ok:false,code:"ENV_REVEAL_NO_POINT",message:"ops/reveal reported success without a point"}'
    exit 3
  fi
  REVEAL_JSON="$(printf '%s' "$RJ" | jq -c '.')"
  HIT_JSON="$(printf '%s' "$RJ" | jq -c '.hit // empty')"
  [ -n "$HIT_JSON" ] || HIT_JSON="null"
fi

# T22 (E18): --expect-change turns "I injected a click" into "the screen changed". Only observable
# fields that this tool can read without the target app's cooperation are allowed.
if [ -n "$EXPECT_CHANGE" ]; then
  [ "$ACTION" = click ] || { WA_AUDIT_RESULT=ARG_BAD_CHANGE; echo "--expect-change only applies to click" >&2; exit 2; }
  case "$EXPECT_CHANGE" in *[!a-z,]*|''|,*|*,) WA_AUDIT_RESULT=ARG_BAD_CHANGE; echo "--expect-change takes title and/or rect, comma separated" >&2; exit 2 ;; esac
  _oc="$IFS"; IFS=,
  for _tok in $EXPECT_CHANGE; do
    case "$_tok" in title|rect) ;; *) IFS="$_oc"; WA_AUDIT_RESULT=ARG_BAD_CHANGE; echo "unknown --expect-change field: $_tok (title|rect)" >&2; exit 2 ;; esac
  done
  IFS="$_oc"
fi
case "$TMO" in ''|*[!0-9]*) WA_AUDIT_RESULT=ARG_BAD_TIMEOUT; echo "--timeout must be a number of ms" >&2; exit 2 ;; esac
if [ "$TMO" -lt 100 ] || [ "$TMO" -gt 60000 ]; then
  WA_AUDIT_RESULT=ARG_BAD_TIMEOUT; echo "--timeout must be between 100 and 60000 ms" >&2; exit 2
fi

# T21: text -> geometry -> point. wuia is read-only, so resolving a line needs no grant; the click
# itself still goes through the input gate below (see: never click blind).
if [ -n "$CLICK_TEXT" ]; then
  case "$TIDX" in ''|*[!0-9]*) WA_AUDIT_RESULT=ARG_BAD_INDEX; echo "--text-index must be a non-negative integer" >&2; exit 2 ;; esac
  tl="$(bash "$REPO_DIR/bin/wuia" --hwnd "$HWND" --find-text "$CLICK_TEXT" --limit 200 2>&1)"
  trc=$?
  if [ "$trc" -ne 0 ]; then
    printf '%s\n' "$tl"
    exit "$trc"
  fi
  sel="$(printf '%s' "$tl" | jq -c --argjson i "$TIDX" '.lines[$i] // empty' 2>/dev/null)"
  if [ -z "$sel" ]; then
    WA_AUDIT_RESULT=ENV_NO_TEXT_LINE
    printf '%s\n' "$(jq -nc --arg re "$CLICK_TEXT" --argjson i "$TIDX" '{ok:false,code:"ENV_NO_TEXT_LINE",message:("no text line #" + ($i|tostring) + " matches " + $re)}')"
    exit 3
  fi
  x="$(printf '%s' "$sel" | jq -r '.rect.x')"
  y="$(printf '%s' "$sel" | jq -r '.rect.y')"
  w="$(printf '%s' "$sel" | jq -r '.rect.w')"
  h="$(printf '%s' "$sel" | jq -r '.rect.h')"
  X=$((x + w / 2))
  Y=$((y + h / 2))
  # never click off the window: a long page has lines whose rect is far outside the viewport
  # (live Chromium reports y=-24000 for scrolled-away nodes). Refuse instead of clicking blind.
  wrect="$(bash "$REPO_DIR/bin/wwin" info --hwnd "$HWND" 2>/dev/null | jq -c '.window.rect // empty' 2>/dev/null)"
  if [ -n "$wrect" ]; then
    wx="$(printf '%s' "$wrect" | jq -r '.x')"; wy="$(printf '%s' "$wrect" | jq -r '.y')"
    ww="$(printf '%s' "$wrect" | jq -r '.w')"; wh="$(printf '%s' "$wrect" | jq -r '.h')"
    if [ "$X" -lt "$wx" ] || [ "$X" -ge "$((wx + ww))" ] || [ "$Y" -lt "$wy" ] || [ "$Y" -ge "$((wy + wh))" ]; then
      WA_AUDIT_RESULT=ENV_TEXT_OFFSCREEN
      printf '%s\n' "$(jq -nc --arg re "$CLICK_TEXT" --argjson i "$TIDX" --argjson pt "{\"x\":$X,\"y\":$Y}" \
        --argjson win "$wrect" '{ok:false,code:"ENV_TEXT_OFFSCREEN",message:("line #" + ($i|tostring) + " for " + $re + " sits outside the window; pick a visible line with --text-index"),point:$pt,window:$win}')"
      exit 3
    fi
  fi
  HIT_JSON="$(bash "$REPO_DIR/bin/wuia" --hwnd "$HWND" --point "$X,$Y" 2>/dev/null | jq -c '.under' 2>/dev/null)"
  [ -n "$HIT_JSON" ] || HIT_JSON="null"
fi

# T22: what is under the point, BEFORE injecting. Resolution is read-only (wuia tree walk), so it
# needs no grant; doing it first means a click that changes the UI can still report its target.
if [ -z "$HIT_JSON" ] && [ "$HWND" != "0" ]; then
  case "$ACTION" in
    click|dclick|wheel|hover)
      hj="$(bash "$REPO_DIR/bin/wuia" --hwnd "$HWND" --point "$X,$Y" 2>/dev/null)"
      HIT_JSON="$(printf '%s' "$hj" | jq -c '.under // empty' 2>/dev/null)"
      if [ -z "$HIT_JSON" ]; then
        HIT_JSON="null"
        HIT_REASON="$(printf '%s' "$hj" | jq -r '.code // "point resolved to no element"' 2>/dev/null)"
        [ -n "$HIT_REASON" ] || HIT_REASON="point resolved to no element"
      fi ;;
  esac
fi
if [ "$ACTION" = hover ] || [ "$ACTION" = wheel ]; then UNDER_JSON="$HIT_JSON"; fi

if [ -n "$VERIFY_MODE" ] && [ "$ACTION" != type ]; then
  WA_AUDIT_RESULT=ARG_BAD_VERIFY; echo '--verify only applies to type' >&2; exit 2
fi

case "$ACTION" in
  type)
    srcs=0
    [ "$TEXT_SET" -eq 1 ] && srcs=$((srcs+1))
    [ -n "$TF" ] && srcs=$((srcs+1))
    [ "$USE_STDIN" -eq 1 ] && srcs=$((srcs+1))
    [ -n "$B64" ] && srcs=$((srcs+1))
    if [ "$srcs" -eq 0 ]; then
      WA_AUDIT_RESULT=ARG_NEED_TEXT; echo "type needs --text, --text-file, --stdin or --text-b64" >&2; exit 2
    fi
    if [ "$srcs" -gt 1 ]; then
      WA_AUDIT_RESULT=ARG_TOO_MANY_TEXT; echo "--text/--text-file/--stdin/--text-b64 are mutually exclusive" >&2; exit 2
    fi
    if [ "$B64" != "" ]; then
      if ! printf '%s' "$B64" | base64 -d > "$APP_ROOT/tmp/b64-$$.txt" 2>/dev/null; then
        WA_AUDIT_RESULT=ARG_BAD_B64; echo "--text-b64 is not valid base64" >&2; exit 2
      fi
      TF="$APP_ROOT/tmp/b64-$$.txt"
    elif [ "$USE_STDIN" -eq 1 ]; then
      mkdir -p "$APP_ROOT/tmp"
      TF="$APP_ROOT/tmp/stdin-$$.txt"
      cat > "$TF"
    fi
    case "$VERIFY_MODE" in ""|exact|contains) ;; *) WA_AUDIT_RESULT=ARG_BAD_VERIFY; echo "--verify must be exact or contains" >&2; exit 2 ;; esac
    if [ -n "$TF" ]; then
      # T14: a WSL path is staged into a Windows-visible temp file, so /tmp/... works (docs/19 F4).
      SRC=""
      if [ -f "$TF" ]; then SRC="$TF"
      elif [ -f "$(wa_wslpath "$TF")" ]; then SRC="$(wa_wslpath "$TF")"
      fi
      if [ -z "$SRC" ]; then
        WA_AUDIT_RESULT=ARG_TEXT_FILE_NOT_FOUND
        echo "text file not found: $TF (ARG_TEXT_FILE_NOT_FOUND); pass a path readable from WSL or Windows" >&2; exit 2
      fi
      if [ ! -s "$SRC" ]; then
        WA_AUDIT_RESULT=ARG_EMPTY_TEXT; echo "refusing to type empty text (ARG_EMPTY_TEXT), file: $TF" >&2; exit 2
      fi
      mkdir -p "$APP_ROOT/tmp"
      STAGED="$APP_ROOT/tmp/type-src-$$.txt"
      cp "$SRC" "$STAGED" || { WA_AUDIT_RESULT=EXEC_STAGE_FAILED; echo "cannot stage $SRC" >&2; exit 5; }
      TF="$STAGED"
    fi
    if [ -n "$TF" ] && [ ! -s "$TF" ]; then
      WA_AUDIT_RESULT=ARG_EMPTY_TEXT; echo "refusing to type empty text (ARG_EMPTY_TEXT)" >&2; exit 2
    fi
    if [ "$TEXT_SET" -eq 1 ] && [ -z "$TEXT" ]; then
      WA_AUDIT_RESULT=ARG_EMPTY_TEXT; echo "refusing to type empty text (ARG_EMPTY_TEXT)" >&2; exit 2
    fi ;;
esac

# S1/S2: real injection must pass the guard; dry-run never touches the desktop, but logging it is M3.
if [ "$REAL" -eq 1 ]; then
  g="$(bash "$REPO_DIR/guard/check.sh" input)"
  grc=$?
  if [ $grc -ne 0 ]; then
    WA_AUDIT_RESULT="$(printf '%s' "$g" | jq -r '.code // "GUARD_DENIED"' 2>/dev/null || echo GUARD_DENIED)"
    printf '%s\n' "$g"; exit $grc
  fi
fi

args=(winput -Version "$VERSION" -Action "$ACTION")
case "$ACTION" in
  move|click|dclick|wheel|hover) args+=(-X "$X" -Y "$Y") ;;
  drag) args+=(-X "$X" -Y "$Y" -X2 "$X2" -Y2 "$Y2" -Steps "$STEPS") ;;
  key) args+=(-Combo "$COMBO" -Hold "$HOLD") ;;
  keydown|keyup) args+=(-VkName "$COMBO") ;;
esac
args+=(-HeldFile "$(wa_winpath "$HELD_FILE")")
[ "$ACTION" = "click" ] && args+=(-Button "$BUTTON" -Count "$COUNT")
if [ "$ACTION" = "wheel" ]; then
  args+=(-Delta "$DELTA" -Times "$TIMES")
  [ "$HORIZ" -eq 1 ] && args+=(-Horizontal)
fi
[ "$ACTION" = "hover" ] && args+=(-Steps "$STEPS" -Dwell "$DWELL")
[ "$HWND" != "0" ] && args+=(-ExpectHwnd "$HWND")
[ -n "$EXPECT_CHANGE" ] && args+=(-ExpectChange "$EXPECT_CHANGE" -TimeoutMs "$TMO")
[ "$FOCUS" -eq 1 ] && args+=(-Focus)
[ "$ALLOW_RELATED" -eq 1 ] && args+=(-AllowRelated)
[ "$NOCLIP" -eq 1 ] && args+=(-NoRestoreClip)
[ "$FORCE" -eq 1 ] && args+=(-Force)
[ "$REAL" -eq 0 ] && args+=(-DryRun)

typef=""
if [ "$ACTION" = "type" ]; then
  if [ "$TEXT_SET" -eq 1 ]; then
    mkdir -p "$APP_ROOT/tmp"
    TF="$APP_ROOT/tmp/type-$$.txt"
    typef="$TF"
    printf '%s' "$TEXT" > "$TF"
  fi
  args+=(-TextFile "$(wa_winpath "$TF")")
  [ -n "$VERIFY_MODE" ] && args+=(-VerifyMode "$VERIFY_MODE")
fi

raw="$(wa_run "${args[@]}")"
[ -n "$typef" ] && rm -f "$typef"; rm -f "$APP_ROOT/tmp/type-src-$$.txt"

# S9: never leave keys stuck - warn (and on failure, release) when something is still held.
if [ -f "$HELD_FILE" ] && [ "$ACTION" != "keydown" ]; then
  echo "winput: WARNING keys still held (see '$HELD_FILE'); run 'winput releaseall --yes'" >&2
fi

j="$(wa_json_of "$raw")"
if [ -z "$j" ]; then
  WA_AUDIT_RESULT=EXEC_NO_JSON
  printf '%s\n' "$raw" >&2
  wa_err_json EXEC_FAIL "no JSON from payload (see stderr)"
  exit 5
fi
# T22: click always carries hit (object, or null + hitReason); hover/wheel keep their v1.2
# under{window,element} (m7 asserts it) and add underNode for the warm-tree rect hit (E18-5:
# Chromium's FromPoint gives Window/RootWebArea for page points, the warm-tree hit is the useful one).
case "$ACTION" in
  click|dclick)
    if [ -n "$HIT_JSON" ]; then
      # E18-1: a click at a control's centre usually lands on an inner TextBlock. Report the clickable
      # ancestor as hit (that is the control a click acts on) and keep the literal element in hit.raw.
      j="$(printf '%s' "$j" | jq -c --argjson hit "$HIT_JSON" '
        . + {hit: (
          if ($hit | type) != "object" then $hit
          elif ($hit.actionable // false) then $hit
          elif (($hit.clickable // null) != null) then (($hit.clickable) + {raw: $hit})
          else $hit end)}' 2>/dev/null || printf '%s' "$j")"
      if [ -n "$HIT_REASON" ]; then
        j="$(printf '%s' "$j" | jq -c --arg r "$HIT_REASON" '. + {hitReason: $r}' 2>/dev/null || printf '%s' "$j")"
      fi
      if [ -n "${REVEAL_JSON}" ]; then
        j="$(printf '%s' "$j" | jq -c --argjson r "${REVEAL_JSON}" '. + {reveal: $r}' 2>/dev/null || printf '%s' "$j")"
      fi
    fi ;;
  hover|wheel)
    if [ -n "$UNDER_JSON" ]; then
      j="$(printf '%s' "$j" | jq -c --argjson u "$UNDER_JSON" '. + {underNode: $u}' 2>/dev/null || printf '%s' "$j")"
    fi ;;
esac
printf '%s\n' "$j"
if printf '%s' "$j" | jq -e '.ok == true' >/dev/null 2>&1; then
  if [ "$REAL" -eq 1 ]; then WA_AUDIT_RESULT=ok; else WA_AUDIT_RESULT=dryrun; fi
  exit 0
fi
code="$(printf '%s' "$j" | jq -r '.code // "EXEC_FAIL"' 2>/dev/null)"
[ -n "$code" ] || code=EXEC_FAIL
WA_AUDIT_RESULT="$code"
wa_exit_for "$code"