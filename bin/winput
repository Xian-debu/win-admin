#!/usr/bin/env bash
# bin/winput - guarded synthetic input. Dry-run by default; real injection needs --yes + a valid grant.
set -uo pipefail
. "$(dirname "$0")/../lib/common.sh"
. "$(dirname "$0")/../lib/audit.sh"
wa_audit_init winput "$@"

usage() {
  cat <<'EOF'
usage:
  winput move X Y
  winput click X Y [--button left|right|middle] [--count N]
  winput dclick X Y
  winput drag X1 Y1 X2 Y2 [--steps N]
  winput wheel [X Y | --at X,Y] [--delta N] [--times N] [--horizontal]
                              scroll at a point (default delta 120 = one notch, +away/-toward)
  winput hover X Y [--steps N] [--dwell MS]
                              glide to a point, dwell, then report the element under it
  winput key COMBO [--hold MS]  (e.g. ctrl+s, alt+f4, enter, f5) - hold keeps keys down MS ms
  winput keydown KEY          press and KEEP DOWN one key (a, shift, f5, space)
  winput keyup KEY            release one key pressed with keydown
  winput releaseall           release every key left down (safety net; also --dry-run)
  winput type --text "..." | --text-file PATH | --stdin | --text-b64 B64
                              --stdin reads UTF-8 from standard input (quote-proof, preferred);
                              --text-b64 takes base64 so no shell quoting applies at all.
                              --text-file accepts a WSL path (/tmp/x.txt) or a Windows path;
                              empty text is an error (ARG_EMPTY_TEXT), a missing file is
                              ARG_TEXT_FILE_NOT_FOUND - never a silent no-op.
                              --verify exact|contains reads the focused element back and
                              fails rc=3 ENV_TEXT_NOT_ENTERED when the text did not land.
Flags for all actions:
  --yes              actually inject (default is --dry-run)
  --dry-run          only print the plan (default)
  --expect-hwnd H    required for click/dclick/drag (S7: never click blind)
  --focus            try SetForegroundWindow when target is not foreground
  --allow-related    accept a point/foreground that lands on an owner or child dialog of
                     --expect-hwnd (same window family); JSON reports matched:"related"
  --no-restore-clip  for type: do not restore the previous clipboard
exit 0 ok | 2 arg | 3 env (locked / wrong window / not foreground) | 4 guard | 5 exec
EOF
}

ACTION=""; X=""; Y=""; X2=""; Y2=""; BUTTON="left"; COUNT=1; STEPS=20
DELTA=120; TIMES=1; HORIZ=0; DWELL=600; AT=""
COMBO=""; HOLD=20; TEXT=""; TF=""; HWND="0"; REAL=0; FOCUS=0; NOCLIP=0; ALLOW_RELATED=0; VERIFY_MODE=""
TEXT_SET=0; B64=""; USE_STDIN=0
HELD_FILE="$APP_ROOT/tmp/held.json"

[ $# -gt 0 ] || { WA_AUDIT_RESULT=ARG_NO_ARGS; usage >&2; exit 2; }
case "$1" in -h|--help) WA_AUDIT_RESULT=help; usage; exit 0 ;; esac
ACTION="$1"; shift

pos=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) WA_AUDIT_RESULT=help; usage; exit 0 ;;
    --yes) REAL=1; shift ;;
    --dry-run) REAL=0; shift ;;
    --button) BUTTON="$2"; shift 2 ;;
    --count) COUNT="$2"; shift 2 ;;
    --steps) STEPS="$2"; shift 2 ;;
    --delta) DELTA="$2"; shift 2 ;;
    --times) TIMES="$2"; shift 2 ;;
    --horizontal) HORIZ=1; shift ;;
    --dwell) DWELL="$2"; shift 2 ;;
    --hold) HOLD="$2"; shift 2 ;;
    --at) AT="$2"; shift 2 ;;
    --expect-hwnd) HWND="$2"; shift 2 ;;
    --focus) FOCUS=1; shift ;;
    --allow-related) ALLOW_RELATED=1; shift ;;
    --no-restore-clip) NOCLIP=1; shift ;;
    --text) TEXT="$2"; TEXT_SET=1; shift 2 ;;
    --stdin) USE_STDIN=1; shift 2 ;;
    --text-b64) B64="$2"; shift 2 ;;
    --text-file) TF="$2"; shift 2 ;;
    --verify) VERIFY_MODE="$2"; shift 2 ;;
    -*) WA_AUDIT_RESULT=ARG_UNKNOWN_FLAG; echo "unknown flag: $1" >&2; exit 2 ;;
    *) pos+=("$1"); shift ;;
  esac
done

case "$ACTION" in
  move)
    [ ${#pos[@]} -eq 2 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "move needs X Y" >&2; exit 2; }
    X="${pos[0]}"; Y="${pos[1]}" ;;
  click|dclick)
    [ ${#pos[@]} -eq 2 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "$ACTION needs X Y" >&2; exit 2; }
    X="${pos[0]}"; Y="${pos[1]}" ;;
  drag)
    [ ${#pos[@]} -eq 4 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "drag needs X1 Y1 X2 Y2" >&2; exit 2; }
    X="${pos[0]}"; Y="${pos[1]}"; X2="${pos[2]}"; Y2="${pos[3]}" ;;
  wheel)
    if [ -n "$AT" ]; then
      case "$AT" in *,*) X="${AT%%,*}"; Y="${AT#*,}" ;; *)
        WA_AUDIT_RESULT=ARG_BAD_POS; echo "--at needs X,Y" >&2; exit 2 ;; esac
      [ ${#pos[@]} -eq 0 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "wheel takes either X Y or --at X,Y, not both" >&2; exit 2; }
    else
      [ ${#pos[@]} -eq 2 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "wheel needs a point: X Y or --at X,Y" >&2; exit 2; }
      X="${pos[0]}"; Y="${pos[1]}"
    fi
    case "$X$Y" in *[!0-9-]*) WA_AUDIT_RESULT=ARG_BAD_POS; echo "not a number: $X,$Y" >&2; exit 2 ;; esac ;;
  hover)
    [ ${#pos[@]} -eq 2 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "hover needs X Y" >&2; exit 2; }
    X="${pos[0]}"; Y="${pos[1]}" ;;
  key)
    [ ${#pos[@]} -eq 1 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "key needs a combo like ctrl+s" >&2; exit 2; }
    COMBO="${pos[0]}" ;;
  keydown|keyup)
    [ ${#pos[@]} -eq 1 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "$ACTION needs one key name" >&2; exit 2; }
    COMBO="${pos[0]}" ;;
  releaseall)
    [ ${#pos[@]} -eq 0 ] || { WA_AUDIT_RESULT=ARG_BAD_POS; echo "releaseall takes no arguments" >&2; exit 2; } ;;
  type) : ;;
  move|click|dclick|drag|wheel|hover|key|keydown|keyup|releaseall|type) ;;
  *) WA_AUDIT_RESULT=ARG_BAD_ACTION; echo "unknown action: $ACTION" >&2; usage >&2; exit 2 ;;
esac

if [ -n "$VERIFY_MODE" ] && [ "$ACTION" != type ]; then
  WA_AUDIT_RESULT=ARG_BAD_VERIFY; echo '--verify only applies to type' >&2; exit 2
fi

case "$ACTION" in
  type)
    srcs=0
    [ "$TEXT_SET" -eq 1 ] && srcs=$((srcs+1))
    [ -n "$TF" ] && srcs=$((srcs+1))
    [ "$USE_STDIN" -eq 1 ] && srcs=$((srcs+1))
    [ -n "$B64" ] && srcs=$((srcs+1))
    if [ "$srcs" -eq 0 ]; then
      WA_AUDIT_RESULT=ARG_NEED_TEXT; echo "type needs --text, --text-file, --stdin or --text-b64" >&2; exit 2
    fi
    if [ "$srcs" -gt 1 ]; then
      WA_AUDIT_RESULT=ARG_TOO_MANY_TEXT; echo "--text/--text-file/--stdin/--text-b64 are mutually exclusive" >&2; exit 2
    fi
    if [ "$B64" != "" ]; then
      if ! printf '%s' "$B64" | base64 -d > "$APP_ROOT/tmp/b64-$$.txt" 2>/dev/null; then
        WA_AUDIT_RESULT=ARG_BAD_B64; echo "--text-b64 is not valid base64" >&2; exit 2
      fi
      TF="$APP_ROOT/tmp/b64-$$.txt"
    elif [ "$USE_STDIN" -eq 1 ]; then
      mkdir -p "$APP_ROOT/tmp"
      TF="$APP_ROOT/tmp/stdin-$$.txt"
      cat > "$TF"
    fi
    case "$VERIFY_MODE" in ""|exact|contains) ;; *) WA_AUDIT_RESULT=ARG_BAD_VERIFY; echo "--verify must be exact or contains" >&2; exit 2 ;; esac
    if [ -n "$TF" ]; then
      # T14: a WSL path is staged into a Windows-visible temp file, so /tmp/... works (docs/19 F4).
      SRC=""
      if [ -f "$TF" ]; then SRC="$TF"
      elif [ -f "$(wa_wslpath "$TF")" ]; then SRC="$(wa_wslpath "$TF")"
      fi
      if [ -z "$SRC" ]; then
        WA_AUDIT_RESULT=ARG_TEXT_FILE_NOT_FOUND
        echo "text file not found: $TF (ARG_TEXT_FILE_NOT_FOUND); pass a path readable from WSL or Windows" >&2; exit 2
      fi
      if [ ! -s "$SRC" ]; then
        WA_AUDIT_RESULT=ARG_EMPTY_TEXT; echo "refusing to type empty text (ARG_EMPTY_TEXT), file: $TF" >&2; exit 2
      fi
      mkdir -p "$APP_ROOT/tmp"
      STAGED="$APP_ROOT/tmp/type-src-$$.txt"
      cp "$SRC" "$STAGED" || { WA_AUDIT_RESULT=EXEC_STAGE_FAILED; echo "cannot stage $SRC" >&2; exit 5; }
      TF="$STAGED"
    fi
    if [ -n "$TF" ] && [ ! -s "$TF" ]; then
      WA_AUDIT_RESULT=ARG_EMPTY_TEXT; echo "refusing to type empty text (ARG_EMPTY_TEXT)" >&2; exit 2
    fi
    if [ "$TEXT_SET" -eq 1 ] && [ -z "$TEXT" ]; then
      WA_AUDIT_RESULT=ARG_EMPTY_TEXT; echo "refusing to type empty text (ARG_EMPTY_TEXT)" >&2; exit 2
    fi ;;
esac

# S1/S2: real injection must pass the guard; dry-run never touches the desktop, but logging it is M3.
if [ "$REAL" -eq 1 ]; then
  g="$(bash "$REPO_DIR/guard/check.sh" input)"
  grc=$?
  if [ $grc -ne 0 ]; then
    WA_AUDIT_RESULT="$(printf '%s' "$g" | jq -r '.code // "GUARD_DENIED"' 2>/dev/null || echo GUARD_DENIED)"
    printf '%s\n' "$g"; exit $grc
  fi
fi

args=(winput -Version "$VERSION" -Action "$ACTION")
case "$ACTION" in
  move|click|dclick|wheel|hover) args+=(-X "$X" -Y "$Y") ;;
  drag) args+=(-X "$X" -Y "$Y" -X2 "$X2" -Y2 "$Y2" -Steps "$STEPS") ;;
  key) args+=(-Combo "$COMBO" -Hold "$HOLD") ;;
  keydown|keyup) args+=(-VkName "$COMBO") ;;
esac
args+=(-HeldFile "$(wa_winpath "$HELD_FILE")")
[ "$ACTION" = "click" ] && args+=(-Button "$BUTTON" -Count "$COUNT")
if [ "$ACTION" = "wheel" ]; then
  args+=(-Delta "$DELTA" -Times "$TIMES")
  [ "$HORIZ" -eq 1 ] && args+=(-Horizontal)
fi
[ "$ACTION" = "hover" ] && args+=(-Steps "$STEPS" -Dwell "$DWELL")
[ "$HWND" != "0" ] && args+=(-ExpectHwnd "$HWND")
[ "$FOCUS" -eq 1 ] && args+=(-Focus)
[ "$ALLOW_RELATED" -eq 1 ] && args+=(-AllowRelated)
[ "$NOCLIP" -eq 1 ] && args+=(-NoRestoreClip)
[ "$REAL" -eq 0 ] && args+=(-DryRun)

typef=""
if [ "$ACTION" = "type" ]; then
  if [ "$TEXT_SET" -eq 1 ]; then
    mkdir -p "$APP_ROOT/tmp"
    TF="$APP_ROOT/tmp/type-$$.txt"
    typef="$TF"
    printf '%s' "$TEXT" > "$TF"
  fi
  args+=(-TextFile "$(wa_winpath "$TF")")
  [ -n "$VERIFY_MODE" ] && args+=(-VerifyMode "$VERIFY_MODE")
fi

raw="$(wa_run "${args[@]}")"
[ -n "$typef" ] && rm -f "$typef"; rm -f "$APP_ROOT/tmp/type-src-$$.txt"

# S9: never leave keys stuck - warn (and on failure, release) when something is still held.
if [ -f "$HELD_FILE" ] && [ "$ACTION" != "keydown" ]; then
  echo "winput: WARNING keys still held (see '$HELD_FILE'); run 'winput releaseall --yes'" >&2
fi

j="$(wa_json_of "$raw")"
if [ -z "$j" ]; then
  WA_AUDIT_RESULT=EXEC_NO_JSON
  printf '%s\n' "$raw" >&2
  wa_err_json EXEC_FAIL "no JSON from payload (see stderr)"
  exit 5
fi
printf '%s\n' "$j"
if printf '%s' "$j" | jq -e '.ok == true' >/dev/null 2>&1; then
  if [ "$REAL" -eq 1 ]; then WA_AUDIT_RESULT=ok; else WA_AUDIT_RESULT=dryrun; fi
  exit 0
fi
code="$(printf '%s' "$j" | jq -r '.code // "EXEC_FAIL"' 2>/dev/null)"
[ -n "$code" ] || code=EXEC_FAIL
WA_AUDIT_RESULT="$code"
wa_exit_for "$code"