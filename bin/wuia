#!/usr/bin/env bash
# bin/wuia - UI Automation: list windows, dump a bounded tree, find elements, probe a point, act on one.
set -uo pipefail
. "$(dirname "$0")/../lib/common.sh"
. "$(dirname "$0")/../lib/audit.sh"
wa_audit_init wuia "$@"

LIST=0; HWND=""; TITLE=""; DEPTH=""; MAX=""; FILTER=""; VALUE=0; NOWARM=0; NODEEP=0; WMS=""; WPS=""; FTEXT=""; PMODE="auto"; READTEXT=0; SCROLLINFO=0; SCROLLTO=""
FNAME=""; FTYPE=""; FAID=""; FCLASS=""; FENABLED=0; FONSCREEN=0; INDEX=0; LIMIT=20
PX=""; PY=""; ACT=""; SETV=""; SETV_GIVEN=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      cat <<'EOF'
usage:
  wuia --list
  wuia (--hwnd 0x1234 | --title REGEX) [--depth N] [--max N] [--filter REGEX]
  wuia (--hwnd H | --title RE) --value        read the first ValuePattern value under the window
  wuia (--hwnd H | --title RE) --read-text    read the richest TextPattern text (T24: the page body);
       ENV_NO_TEXT exit 3 when the window has no TextPattern (ops/read-text adds a
       clipboard fallback, which needs an input grant)
  wuia --point X,Y                            what element is under a screen point (+ ancestors)

  text lines + geometric hit-test (T21):
  wuia (--hwnd H | --title RE) --find-text RE [--limit N]
       returns {mode:"textlines", total, count, lines:[{text,rect,depth,type,name,aid,
       actionable,clickable}]} sorted by (rect.y, rect.x); only lines with a name and a real rect.
  wuia (--hwnd H | --title RE) --point X,Y [--point-mode auto|rect|uia]
       what is really at that screen point: FromPoint first, then the smallest named/actionable
       rect in the warm tree containing the point (via:"rect-hit"; containers are skipped, so a
       blank page area is ENV_NO_HIT exit 3 instead of a fake "Document" hit).
       --point-mode rect forces the rect answer, uia forces the FromPoint answer.
       hint: click-by-text lives in "winput click --click-text RE" (injection needs an input grant).

  scroll container (T28, v1.4):
  wuia (--hwnd H | --title RE) --scroll-info (--point X,Y | a find condition)
       which element owns the scroll under that point / element:
       {mode:"scrollinfo", via:"scroll-pattern"|"rect"|"none", scrollable,
        container:{name,type,aid,class,rect,patterns,scroll:{verticallyScrollable,
        horizontallyScrollable,percentY,viewHeight,...}}, chain:[...]}
       via:"scroll-pattern" is positive evidence (the container really has ScrollPattern);
       via:"rect" is a clipping ancestor without a pattern (scroll numbers are null);
       no container at all still exits 0 with scrollable:false, so "not scrollable" and
       "not found" cannot be confused.
       ENV_NO_HIT exit 3 for a point over nothing; ENV_NO_MATCH exit 3 for no find match.

  scroll to (T29, v1.4):
  wuia (--hwnd H | --title RE) --scroll-set-percent N (a find condition) [--index N]
       move the nearest ScrollPattern owner (self or ancestor) to N percent, then read the state
       back: {mode:"scrollto", target, container:{...scroll}, requested, before, after,
       moved:false|true}. moved:false is legal (already there); the caller decides.
       ENV_NO_PATTERN exit 3 when nothing up the chain scrolls; ENV_ACTION_FAILED exit 3 when the
       provider throws.

  find (T5):
  wuia (--hwnd H | --title RE) --find-name RE [--find-type RE] [--find-aid RE] [--find-class RE]
       [--enabled] [--on-screen] [--index N] [--limit N] [--depth N] [--max N]
       returns {total, count, nodes:[{name,type,aid,class,rect,enabled,offscreen,patterns[]}]}
       T20: find/action default --depth 20 (tree stays 3); an empty result deepens once to 28
       (deepened:true) and the walk is retried after 250 ms while Chromium builds its a11y tree
       (passes/warmMs/warmRetries/depthUsed in the JSON). Tuning: --warm-ms MS (default 250),
       --warm-passes N (default 3). Escape hatches: --no-warm / --no-deepen.

  act (T6), always combined with find criteria:
  wuia (--hwnd H | --title RE) --find-name RE [--index N] ACTION
       ACTION = --invoke | --select | --toggle | --expand | --collapse | --focus
              | --get-value | --get-text | --set-value TEXT
       every action returns the state it read back (value/selected/toggleState/expandState/focused);
       a value that does not stick is ENV_STATE_UNCHANGED (exit 3), a missing pattern ENV_NO_PATTERN.
  exit 0 ok | 2 arg | 3 env (no window / no match / no pattern / unchanged) | 5 exec
EOF
      exit 0 ;;
    --list) LIST=1; shift ;;
    --hwnd) HWND="$2"; shift 2 ;;
    --title) TITLE="$2"; shift 2 ;;
    --depth) DEPTH="$2"; shift 2 ;;
    --max) MAX="$2"; shift 2 ;;
    --no-warm) NOWARM=1; shift ;;
    --no-deepen) NODEEP=1; shift ;;
    --warm-ms) WMS="$2"; shift 2 ;;
    --warm-passes) WPS="$2"; shift 2 ;;
    --filter) FILTER="$2"; shift 2 ;;
    --value) VALUE=1; shift ;;
    --find-name) FNAME="$2"; shift 2 ;;
    --find-type) FTYPE="$2"; shift 2 ;;
    --find-aid) FAID="$2"; shift 2 ;;
    --find-class) FCLASS="$2"; shift 2 ;;
    --enabled) FENABLED=1; shift ;;
    --on-screen) FONSCREEN=1; shift ;;
    --index) INDEX="$2"; shift 2 ;;
    --limit) LIMIT="$2"; shift 2 ;;
    --point)
      case "$2" in *,*) PX="${2%%,*}"; PY="${2#*,}" ;; *)
        echo "--point needs X,Y" >&2; exit 2 ;; esac
      shift 2 ;;
    --find-text) FTEXT="$2"; shift 2 ;;
    --point-mode) PMODE="$2"; shift 2 ;;
    --read-text) READTEXT=1; shift ;;
    --scroll-info) SCROLLINFO=1; shift ;;
    --scroll-set-percent) SCROLLINFO=1; SCROLLTO="$2"; shift 2 ;;
    --invoke|--select|--toggle|--expand|--collapse|--focus|--get-value|--get-text)
      ACT="${1#--}"; shift ;;
    --set-value) ACT="set-value"; SETV="$2"; SETV_GIVEN=1; shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

if [ "$LIST" = 0 ] && [ -z "$HWND" ] && [ -z "$TITLE" ] && [ -z "$PX" ]; then
  echo "wuia needs --hwnd, --title, --list or --point" >&2; exit 2
fi
if [ -n "$ACT" ] && [ -z "$FNAME$FTYPE$FAID$FCLASS" ]; then
  echo "$ACT needs at least one of --find-name/--find-type/--find-aid/--find-class" >&2; exit 2
fi
if [ -n "$PX" ]; then
  case "$PX$PY" in *[!0-9-]*) echo "--point needs numbers" >&2; exit 2 ;; esac
fi
case "$PMODE" in
  auto|rect|uia) ;;
  *) echo "--point-mode must be auto, rect or uia" >&2; exit 2 ;;
esac

# acting on a control is injection: it needs a grant, exactly like winput (T6). find/point/tree
# are read-only and stay ungated.
if [ -n "$ACT" ]; then
  g="$(bash "$REPO_DIR/guard/check.sh" input)"
  grc=$?
  if [ "$grc" -ne 0 ]; then
    WA_AUDIT_RESULT="$(printf '%s' "$g" | jq -r '.code // "GUARD_DENIED"' 2>/dev/null || echo GUARD_DENIED)"
    printf '%s\n' "$g"; exit "$grc"
  fi
fi

args=(wuia -Version "$VERSION" -Limit "$LIMIT" -Index "$INDEX")
[ -n "$DEPTH" ] && args+=(-Depth "$DEPTH")
[ -n "$MAX" ] && args+=(-MaxNodes "$MAX")
[ "$NOWARM" = 1 ] && args+=(-NoWarm)
[ "$NODEEP" = 1 ] && args+=(-NoDeepen)
[ -n "$WMS" ] && args+=(-WarmMs "$WMS")
[ -n "$WPS" ] && args+=(-WarmPasses "$WPS")
[ "$LIST" = 1 ] && args+=(-List)
[ -n "$HWND" ] && args+=(-Hwnd "$((HWND))")
[ -n "$TITLE" ] && args+=(-Title "$TITLE")
[ -n "$FILTER" ] && args+=(-Filter "$FILTER")
[ "$VALUE" = 1 ] && args+=(-Value)
[ "$READTEXT" = 1 ] && args+=(-ReadText)
[ "$SCROLLINFO" = 1 ] && args+=(-ScrollInfo)
[ -n "$SCROLLTO" ] && args+=(-ScrollToPercent "$SCROLLTO")
[ -n "$FTEXT" ] && args+=(-FindText "$FTEXT")
[ -n "$FNAME" ] && args+=(-FindName "$FNAME")
[ -n "$FTYPE" ] && args+=(-FindType "$FTYPE")
[ -n "$FAID" ] && args+=(-FindAid "$FAID")
[ -n "$FCLASS" ] && args+=(-FindClass "$FCLASS")
[ "$FENABLED" = 1 ] && args+=(-EnabledOnly)
[ "$FONSCREEN" = 1 ] && args+=(-OnScreenOnly)
[ -n "$PX" ] && args+=(-PointX "$PX" -PointY "$PY" -PointMode "$PMODE")
[ -n "$ACT" ] && args+=(-Action "$ACT")
[ "$SETV_GIVEN" = 1 ] && args+=(-SetValue "$SETV" -SetValueGiven)

raw="$(wa_run "${args[@]}")"
wa_finish "$raw"
