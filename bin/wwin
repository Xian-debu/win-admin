#!/usr/bin/env bash
# bin/wwin - window inventory and window state control.
#   list/info/focus/close : read or gentle foreground ops (no synthetic input).
#   state                 : full window state (normal/minimized/maximized, topmost, rect, work area).
#   set                   : maximize/minimize/restore/move/resize/topmost. Dry-run by default;
#                           real changes need --yes AND an unexpired grant covering input.
set -uo pipefail
. "$(dirname "$0")/../lib/common.sh"

usage() {
  cat <<'EOF'
usage:
  wwin list
  wwin info  --hwnd 0x1234
  wwin focus --hwnd 0x1234 [--yes]   (--yes is accepted and ignored: focus never injects)
  wwin close --hwnd 0x1234
  wwin state --hwnd 0x1234
  wwin set   --hwnd 0x1234 [--state max|min|restore|normal]
                          [--x N] [--y N] [--w N] [--h N] [--topmost on|off]
                          [--yes] [--dry-run]

set flags:
  --yes            actually apply (default is --dry-run; --yes needs an input grant)
  --dry-run        only print the plan plus the current state (default)
  --state max      maximize        --state restore  un-maximize / un-minimize
  --state min      minimize        --state normal   plain normal window
  --x/--y          move to that screen position (physical px, per-monitor-v2 aware)
  --w/--h          resize (width/height in physical px)
  --topmost on|off z-order pin

Every set prints before/after and FAILS (ENV_STATE_UNCHANGED, exit 3) when the window did not
actually end up in the requested state - a silent no-op is an error here, not a success.

exit 0 ok | 2 arg | 3 ENV_NO_WINDOW / ENV_NOT_FOREGROUND / ENV_STATE_UNCHANGED | 4 guard | 5 exec
EOF
}

sub="${1:-list}"
case "$sub" in
  -h|--help|help) usage; exit 0 ;;
  list)
    shift || true
    raw="$(wa_run wwin -Action list)"
    wa_finish "$raw" ;;
  info|focus|close|state)
    shift || true
    H=""; IGN=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --hwnd) H="$2"; shift 2 ;;
        # T24: focus is a read/gentle op that never injected anything, so the "use --yes" habit from
        # the docs used to fail here. Accept it, ignore it, and say so in the JSON (C18-3).
        --yes) if [ "$sub" = focus ]; then IGN=1; shift; else echo "unknown arg: $1" >&2; exit 2; fi ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
      esac
    done
    [ -n "$H" ] || { echo "$sub needs --hwnd" >&2; exit 2; }
    raw="$(wa_run wwin -Action "$sub" -Hwnd "$((H))")"
    if [ "$IGN" -eq 1 ]; then
      j="$(wa_finish "$raw")" || exit $?
      printf '%s\n' "$j" | jq -c '. + {ignoredFlags: ["--yes"]}'
      exit 0
    fi
    wa_finish "$raw" ;;
  set)
    shift || true
    . "$(dirname "$0")/../lib/audit.sh"
    wa_audit_init wwin set "$@"
    H=""; ST=""; SX=""; SY=""; SW=""; SH=""; TOP=""; REAL=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --hwnd) H="$2"; shift 2 ;;
        --state) ST="$2"; shift 2 ;;
        --x) SX="$2"; shift 2 ;;
        --y) SY="$2"; shift 2 ;;
        --w) SW="$2"; shift 2 ;;
        --h) SH="$2"; shift 2 ;;
        --topmost) TOP="$2"; shift 2 ;;
        --yes) REAL=1; shift ;;
        --dry-run) REAL=0; shift ;;
        *) WA_AUDIT_RESULT=ARG_UNKNOWN_FLAG; echo "unknown arg: $1" >&2; exit 2 ;;
      esac
    done
    [ -n "$H" ] || { WA_AUDIT_RESULT=ARG_NEED_TARGET; echo "set needs --hwnd" >&2; exit 2; }
    case "$ST" in ''|max|min|restore|normal) ;; *)
      WA_AUDIT_RESULT=ARG_BAD_STATE; echo "bad --state: $ST (max|min|restore|normal)" >&2; exit 2 ;;
    esac
    case "$TOP" in ''|on|off) ;; *)
      WA_AUDIT_RESULT=ARG_BAD_TOPMOST; echo "bad --topmost: $TOP (on|off)" >&2; exit 2 ;;
    esac
    if [ -z "$ST" ] && [ -z "$SX" ] && [ -z "$SY" ] && [ -z "$SW" ] && [ -z "$SH" ] && [ -z "$TOP" ]; then
      WA_AUDIT_RESULT=ARG_NOTHING_TO_DO
      echo "set needs at least one of --state/--x/--y/--w/--h/--topmost" >&2; exit 2
    fi
    for v in "$SX" "$SY" "$SW" "$SH"; do
      if [ -n "$v" ]; then
        case "$v" in *[!0-9-]*) WA_AUDIT_RESULT=ARG_BAD_GEOMETRY; echo "not a number: $v" >&2; exit 2 ;; esac
      fi
    done
    # A real state change is input-grade (S9): guard + audit, exactly like winput.
    if [ "$REAL" -eq 1 ]; then
      g="$(bash "$REPO_DIR/guard/check.sh" input)"
      grc=$?
      if [ $grc -ne 0 ]; then
        WA_AUDIT_RESULT="$(printf '%s' "$g" | jq -r '.code // "GUARD_DENIED"' 2>/dev/null || echo GUARD_DENIED)"
        printf '%s\n' "$g"; exit $grc
      fi
    fi
    args=(wwin -Version "$VERSION" -Action set -Hwnd "$((H))")
    [ -n "$ST" ] && args+=(-State "$ST")
    [ -n "$SX" ] && args+=(-X "$SX")
    [ -n "$SY" ] && args+=(-Y "$SY")
    [ -n "$SW" ] && args+=(-Width "$SW")
    [ -n "$SH" ] && args+=(-Height "$SH")
    [ -n "$TOP" ] && args+=(-Topmost "$TOP")
    [ "$REAL" -eq 0 ] && args+=(-DryRun)
    raw="$(wa_run "${args[@]}")"
    j="$(wa_json_of "$raw")"
    if [ -z "$j" ]; then
      WA_AUDIT_RESULT=EXEC_NO_JSON
      printf '%s\n' "$raw" >&2
      wa_err_json EXEC_FAIL "no JSON from payload (see stderr)"
      exit 5
    fi
    printf '%s\n' "$j"
    if printf '%s' "$j" | jq -e '.ok == true' >/dev/null 2>&1; then
      if [ "$REAL" -eq 1 ]; then WA_AUDIT_RESULT=ok; else WA_AUDIT_RESULT=dryrun; fi
      exit 0
    fi
    code="$(printf '%s' "$j" | jq -r '.code // "EXEC_FAIL"' 2>/dev/null)"
    [ -n "$code" ] || code=EXEC_FAIL
    WA_AUDIT_RESULT="$code"
    wa_exit_for "$code" ;;
  *) echo "unsupported action: $sub (list|info|focus|close|state|set)" >&2; exit 2 ;;
esac
