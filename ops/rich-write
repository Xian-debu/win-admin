#!/usr/bin/env bash
# ops/rich-write - replace the content of a rich text editor and PROVE it landed. v1.4 (T31, F22-3).
# Clicking an editor, pressing ctrl+a and pasting is easy; knowing the paste went into the editor
# and not into the page is not. So a successful run always reads the document back through
# TextPattern and compares it with the file: a PREFIX match is required, because editors append a
# trailing newline (or their own placeholder) and an exact compare would flap on that alone.
set -uo pipefail
. "$(dirname "$0")/../lib/common.sh"
. "$(dirname "$0")/../lib/audit.sh"
. "$(dirname "$0")/lib-ops.sh"
wa_audit_init ops-rich-write "$@"

usage() {
  cat <<'EOF'
usage: ops/rich-write (--hwnd H | --title REGEX) --point X,Y --text-file PATH
                      [--verify-aid RE | --verify-name RE] [--timeout MS] [--yes] [--dry-run]
  Clicks the editor at X,Y, selects all (ctrl+a) and pastes PATH, then reads the document back
  and requires the written text to be a PREFIX of what the editor now holds (a trailing newline
  or placeholder is tolerated). {ok,matched:true,method,point,element,chars,gotChars,via,ms}
  The readback target is the element under the point (its aid first, else its name); override it
  with --verify-aid/--verify-name when the point lands on an inner editable of a larger widget.
  A readback that does not match is exit 3 ENV_TEXT_NOT_ENTERED with got/expected prefixes -
  never a silent success. Dry-run by default; real injection needs --yes.
  exit 0 ok | 2 arg | 3 env | 4 guard | 5 exec
EOF
}

HWND=0; TITLE=""; POINT=""; TXTFILE=""; VAID=""; VNAME=""; TMO=1500; REAL=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --hwnd) HWND="$2"; shift 2 ;;
    --title) TITLE="$2"; shift 2 ;;
    --point) POINT="$2"; shift 2 ;;
    --text-file) TXTFILE="$2"; shift 2 ;;
    --verify-aid) VAID="$2"; shift 2 ;;
    --verify-name) VNAME="$2"; shift 2 ;;
    --timeout) TMO="$2"; shift 2 ;;
    --yes) REAL=1; shift ;;
    --dry-run) REAL=0; shift ;;
    *) echo "unknown flag: $1" >&2; usage >&2; exit 2 ;;
  esac
done
[ "$HWND" != "0" ] || [ -n "$TITLE" ] || { echo 'need --hwnd or --title' >&2; exit 2; }
[ -n "$POINT" ] || { echo 'need --point X,Y (the editor)' >&2; exit 2; }
[ -n "$TXTFILE" ] || { echo 'need --text-file PATH' >&2; exit 2; }
case "$TMO" in *[!0-9]*) echo '--timeout must be a number' >&2; exit 2 ;; esac
case "$POINT" in *,*) ;; *) echo '--point must be X,Y' >&2; exit 2 ;; esac
[ -f "$TXTFILE" ] || { jq -nc --arg f "$TXTFILE" '{ok:false,tool:"ops/rich-write",code:"ARG_TEXT_FILE_NOT_FOUND",message:("no such file: " + $f),file:$f}'; exit 2; }
WANT="$(cat "$TXTFILE")"; WANT="$(printf '%s' "$WANT" | tr -d '\r')"
[ -n "$WANT" ] || { jq -nc --arg f "$TXTFILE" '{ok:false,tool:"ops/rich-write",code:"ARG_EMPTY_TEXT",message:"text file is empty",file:$f}'; exit 2; }

op_pause_gate read
H="$(op_resolve_hwnd "$HWND" "$TITLE")" || { printf '%s\n' "$H"; exit 3; }
H="$(printf '%s' "$H" | tr -d '[:space:]')"
PX="$(printf '%s' "$POINT" | cut -d, -f1 | tr -d ' ')"
PY="$(printf '%s' "$POINT" | cut -d, -f2 | tr -d ' ')"

# The element under the point is the readback target: its aid (stable, unique) or else its name.
UNDER="$(bash "$REPO_DIR/bin/wuia" --point "$PX,$PY" 2>/dev/null || true)"
UAID="$(printf '%s' "$UNDER" | jq -r '.under.aid // empty' 2>/dev/null)"
UNAME="$(printf '%s' "$UNDER" | jq -r '.under.name // empty' 2>/dev/null)"
UTYPE="$(printf '%s' "$UNDER" | jq -r '.under.type // empty' 2>/dev/null)"
WANT1="$(printf '%s' "$WANT" | head -n 1)"
WANTC="$(printf '%s' "$WANT" | wc -m | tr -d ' ')"
WANTL="$(printf '%s' "$WANT" | wc -l | tr -d ' ')"

if [ "$REAL" -eq 0 ]; then
  WA_AUDIT_RESULT=dryrun
  jq -nc --arg h "$H" --arg p "$POINT" --arg f "$TXTFILE" --argjson c "$WANTC" --arg first "$WANT1" \
    --arg ua "$UAID" --arg un "$UNAME" --arg ut "$UTYPE" --argjson l "$((WANTL+1))" \
    '{ok:true,tool:"ops/rich-write",dry_run:true,plan:["focus","click-point","ctrl+a","type-text-file","readback"],hwnd:$h,point:$p,file:$f,expectedChars:$c,expectedLines:$l,firstLine:$first,element:{aid:$ua,name:$un,type:$ut},verdict:"prefix"}'
  exit 0
fi

op_pause_gate input
op_focus "$H" >/dev/null || {
  FC="$OP_FOCUS_CODE"; [ -n "$FC" ] || FC=ENV_NOT_FOREGROUND
  WA_AUDIT_RESULT="$FC"
  jq -nc --arg h "$H" --arg c "$FC" --arg m "$OP_FOCUS_MSG" '{ok:false,tool:"ops/rich-write",code:$c,message:$m,hwnd:$h}'
  exit 3
}

CJ="$(bash "$REPO_DIR/bin/winput" click "$PX" "$PY" --expect-hwnd "$H" --yes --focus 2>&1)"; CRC=$?
if [ "$CRC" -ne 0 ]; then
  CC="$(printf '%s' "$CJ" | jq -r '.code // empty' 2>/dev/null)"; [ -n "$CC" ] || CC=EXEC_CLICK_FAILED
  WA_AUDIT_RESULT="$CC"
  printf '%s' "$CJ" | jq -c --arg step click-point --arg h "$H" '. + {tool:"ops/rich-write",step:$step,hwnd:$h}' 2>/dev/null || jq -nc --arg c "$CC" '{ok:false,code:$c}'
  exit "$CRC"
fi
bash "$REPO_DIR/bin/winput" key ctrl+a --expect-hwnd "$H" --yes >/dev/null 2>&1 || true
PJ="$(bash "$REPO_DIR/bin/winput" type --text-file "$TXTFILE" --expect-hwnd "$H" --verify contains --yes 2>&1)"; PRC=$?
if [ "$PRC" -ne 0 ]; then
  PC="$(printf '%s' "$PJ" | jq -r '.code // empty' 2>/dev/null)"; [ -n "$PC" ] || PC=ENV_TEXT_NOT_ENTERED
  WA_AUDIT_RESULT="$PC"
  printf '%s' "$PJ" | jq -c --arg step paste --arg h "$H" --arg p "$POINT" '. + {tool:"ops/rich-write",step:$step,hwnd:$h,point:$p,matched:false}' 2>/dev/null || jq -nc --arg c "$PC" '{ok:false,code:$c}'
  exit "$PRC"
fi

# Readback: the element at the point (aid first), else the window body.
readback() {
  local j=""
  if [ -n "$VAID" ]; then
    j="$(bash "$REPO_DIR/bin/wuia" --hwnd "$H" --find-aid "$VAID" --index 0 --get-text 2>/dev/null)" || return 1
  elif [ -n "$VNAME" ]; then
    j="$(bash "$REPO_DIR/bin/wuia" --hwnd "$H" --find-name "$VNAME" --index 0 --get-text 2>/dev/null)" || return 1
  elif [ -n "$UAID" ]; then
    j="$(bash "$REPO_DIR/bin/wuia" --hwnd "$H" --find-aid "^$UAID$" --index 0 --get-text 2>/dev/null)" || return 1
  elif [ -n "$UNAME" ]; then
    j="$(bash "$REPO_DIR/bin/wuia" --hwnd "$H" --find-name "^$UNAME$" --index 0 --get-text 2>/dev/null)" || return 1
  else
    return 1
  fi
  printf '%s' "$j" | jq -r '.value // empty' 2>/dev/null
}

GOT=""; VIA="element"; T0=$(date +%s%3N); MATCHED=0
while :; do
  GOT="$(readback || true)"
  # Never fall back to the whole window when the caller named a verify target: they asked about
  # that element, and the window body would happily match text that never reached it.
  if [ -z "$GOT" ] && [ -z "$VAID" ] && [ -z "$VNAME" ]; then
    GOT="$(bash "$REPO_DIR/ops/read-text" --hwnd "$H" 2>/dev/null | jq -r '.text // empty' 2>/dev/null)"
    VIA="window"
  fi
  GOT_N="$(printf '%s' "$GOT" | tr -d '\r')"
  # A prefix match is the right verdict: editors append a newline or a placeholder line.
  case "$GOT_N" in "$WANT"*) MATCHED=1 ;; esac
  [ "$MATCHED" -eq 1 ] && break
  [ $(( $(date +%s%3N) - T0 )) -ge "$TMO" ] && break
  sleep 0.12
done
MS=$(( $(date +%s%3N) - T0 ))
GOTC="$(printf '%s' "$GOT" | wc -m | tr -d ' ')"
GOTP="$(printf '%s' "$GOT" | head -c 300)"

if [ "$MATCHED" -ne 1 ]; then
  WA_AUDIT_RESULT=ENV_TEXT_NOT_ENTERED
  jq -nc --arg h "$H" --arg p "$POINT" --arg f "$TXTFILE" --arg got "$GOTP" --arg first "$WANT1" \
    --argjson gc "$GOTC" --argjson wc_ "$WANTC" --argjson ms "$MS" --arg via "$VIA" \
    --arg ua "$UAID" --arg un "$UNAME" --arg ut "$UTYPE" \
    '{ok:false,tool:"ops/rich-write",code:"ENV_TEXT_NOT_ENTERED",message:"the editor did not hold the written text (readback is not a prefix match)",matched:false,hwnd:$h,point:$p,file:$f,expectedChars:$wc_,gotChars:$gc,firstLine:$first,gotPrefix:$got,readback:{via:$via,element:{aid:$ua,name:$un,type:$ut}},ms:$ms}'
  exit 3
fi

WA_AUDIT_RESULT=ok
jq -nc --arg h "$H" --arg p "$POINT" --arg f "$TXTFILE" --argjson gc "$GOTC" --argjson wc_ "$WANTC" \
  --argjson ms "$MS" --arg via "$VIA" --arg ua "$UAID" --arg un "$UNAME" --arg ut "$UTYPE" --arg first "$WANT1" \
  '{ok:true,tool:"ops/rich-write",matched:true,method:"click+ctrl+a+paste",hwnd:$h,point:$p,file:$f,chars:$wc_,expectedChars:$wc_,gotChars:$gc,firstLine:$first,readback:{via:$via,element:{aid:$ua,name:$un,type:$ut}},verdict:"prefix",ms:$ms}'
exit 0
