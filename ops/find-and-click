#!/usr/bin/env bash
# ops/find-and-click - locate a control by UIA name/type and click its center. Dry-run by default.
set -uo pipefail
. "$(dirname "$0")/../lib/common.sh"
. "$(dirname "$0")/../lib/audit.sh"
. "$(dirname "$0")/lib-ops.sh"
wa_audit_init ops-findclick "$@"

usage() {
  cat <<'EOF'
usage: ops/find-and-click (--hwnd H | --title REGEX) [--name REGEX] [--type TYPE] [--index N]
                         [--depth 8] [--max 2000] [--yes] [--focus]
  --name    UIA name regex (omit = first matching control)
  --type    UIA control type regex, e.g. Button|Edit|MenuItem
  default   dry-run: prints the节点 rect and the point it would click
  exit 0 ok | 2 arg | 3 env | 4 guard | 5 exec
EOF
}

HWND=0; TITLE=""; NAME=""; TYPE=""; IDX=0; DEPTH=8; MAX=2000; REAL=0; FOCUS=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --hwnd) HWND="$2"; shift 2 ;;
    --title) TITLE="$2"; shift 2 ;;
    --name) NAME="$2"; shift 2 ;;
    --type) TYPE="$2"; shift 2 ;;
    --index) IDX="$2"; shift 2 ;;
    --depth) DEPTH="$2"; shift 2 ;;
    --max) MAX="$2"; shift 2 ;;
    --yes) REAL=1; shift ;;
    --dry-run) REAL=0; shift ;;
    --focus) FOCUS=1; shift ;;
    *) echo "unknown flag: $1" >&2; usage >&2; exit 2 ;;
  esac
done

H="$(op_resolve_hwnd "$HWND" "$TITLE")"; RC=$?
[ "$RC" -eq 0 ] || { printf '%s\n' "$H"; exit "$RC"; }
H="$((H))"   # jq --argjson does not accept 0x hex
NODE="$(op_find_node "$H" "$NAME" "$TYPE" "$IDX" "$DEPTH" "$MAX")" || op_die EXEC_UIA "wuia failed for hwnd $H"
[ -n "$NODE" ] || op_die ENV_NO_NODE "no control matched (hwnd=$H name=$NAME type=$TYPE index=$IDX)"

CX="$(printf '%s' "$NODE" | jq -r '(.rect.x + (.rect.w/2|floor))|floor')"
CY="$(printf '%s' "$NODE" | jq -r '(.rect.y + (.rect.h/2|floor))|floor')"

if [ "$REAL" -eq 0 ]; then
  WA_AUDIT_RESULT=dryrun
  jq -nc --argjson h "$H" --argjson n "$NODE" --argjson x "$CX" --argjson y "$CY" \
    '{ok:true,dry_run:true,tool:"ops/find-and-click",hwnd:$h,node:$n,point:{x:$x,y:$y}}'
  exit 0
fi

op_pause_gate input
# Activate first: Windows refuses a click on an occluded window (winput never clicks blind).
if ! bash "$REPO_DIR/bin/wwin" focus --hwnd "$H" >/dev/null; then
  WA_AUDIT_RESULT=ENV_NOT_FOREGROUND
  op_die ENV_NOT_FOREGROUND "could not bring hwnd $H to the foreground"
fi
CARGS=(click "$CX" "$CY" --expect-hwnd "$H" --yes)
[ "$FOCUS" -eq 1 ] && CARGS+=(--focus)
CJ="$(bash "$REPO_DIR/bin/winput" "${CARGS[@]}")"
CRC=$?
if [ $CRC -ne 0 ]; then
  CODE="$(printf '%s' "$CJ" | jq -r '.code // "EXEC_CLICK_FAILED"')"
  WA_AUDIT_RESULT="$CODE"
  printf '%s\n' "$CJ"
  exit "$CRC"
fi
WA_AUDIT_RESULT=ok
jq -nc --argjson h "$H" --argjson n "$NODE" --argjson x "$CX" --argjson y "$CY" --argjson c "$CJ" \
  '{ok:true,injected:true,tool:"ops/find-and-click",hwnd:$h,node:$n,point:{x:$x,y:$y},click:$c}'
exit 0
